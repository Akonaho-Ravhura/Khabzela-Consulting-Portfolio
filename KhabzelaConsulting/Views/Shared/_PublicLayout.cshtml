@inject Microsoft.Extensions.Options.IOptions<KhabzelaConsulting.Services.SiteOptions> SiteOptions
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string name) => string.Equals(action, name, StringComparison.OrdinalIgnoreCase) ? "is-active" : "";
    var showClosing = ViewData["HideClosing"] as bool? != true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#16301a" />
    <meta name="description" content="@(ViewData["Description"] ?? "Khabzela Consulting — a Centurion-based accounting firm offering accounting, payroll and tax services to small and medium-sized businesses.")" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] · Khabzela Consulting</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cinzel:wght@600;700&family=Montserrat:wght@300;400&family=Mrs+Saint+Delafield&family=Noto+Serif:wght@400&display=swap" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/icons/icon-192.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layouts/public.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="public-body">
    <partial name="_IconSprite" />
    <span hidden data-flash-toast="@TempData["Toast"]"></span>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" data-site-header>
        <div class="site-container site-header-inner">
            <nav class="site-nav" id="site-nav" aria-label="Main" data-site-nav>
                <a class="@Active("Index")" asp-controller="Home" asp-action="Index">Home</a>
                <a class="@Active("Offering")" asp-controller="Home" asp-action="Offering">Offering</a>
                <a class="@Active("About")" asp-controller="Home" asp-action="About">About</a>
                <a class="@Active("Contact")" asp-controller="Home" asp-action="Contact">Contact</a>
                <a class="site-nav-mobile" asp-controller="Account" asp-action="Login">Client login</a>
            </nav>

            <a class="site-logo" asp-controller="Home" asp-action="Index" aria-label="Khabzela Consulting — home">
                <span class="site-logo-mark" aria-hidden="true">K</span>
                <span class="site-logo-name">Khabzela Consulting</span>
                <span class="site-logo-tag">Accounting · Payroll · Tax</span>
            </a>

            <div class="site-header-actions">
                <a class="site-login" asp-controller="Account" asp-action="Login">Client login</a>
                <a class="btn btn-primary" asp-controller="Home" asp-action="Contact">Contact us</a>
            </div>

            <button class="site-menu-btn" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Open menu" data-menu-toggle>
                <svg class="icon icon-open"><use href="#i-menu" /></svg>
                <svg class="icon icon-close"><use href="#i-x" /></svg>
            </button>
        </div>
    </header>

    <main id="main">
        @RenderBody()

        @if (showClosing)
        {
            <section class="testimonial">
                <figure class="site-container">
                    <blockquote>Khabzela Consulting offered insights on the financial and tax side of my business I never would have thought of. I'm more than happy.</blockquote>
                    <figcaption>- Eugene Khoza</figcaption>
                </figure>
            </section>

            <section class="closing">
                <div class="site-container">
                    <h2>Contact us to schedule an appointment. Let's find the best solutions for your business.</h2>
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Contact">Contact us</a>
                </div>
            </section>
        }
    </main>

    <footer class="site-footer">
        <div class="site-container footer-grid">
            <a class="site-logo footer-logo" asp-controller="Home" asp-action="Index" aria-label="Khabzela Consulting — home">
                <span class="site-logo-mark" aria-hidden="true">K</span>
                <span class="site-logo-name">Khabzela Consulting</span>
                <span class="site-logo-tag">Accounting · Payroll · Tax</span>
            </a>

            <nav class="footer-links" aria-label="Footer">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Home" asp-action="Offering">Offering</a>
                <a asp-controller="Home" asp-action="About">About</a>
                <a asp-controller="Home" asp-action="Contact">Contact</a>
            </nav>

            <address class="footer-contact">
                <span><a href="tel:+27728792715">072 879 2715</a> / <a href="tel:+27716841535">071 684 1535</a></span>
                <span>9 Charles De Gaulle Crescent, Highveld</span>
                <a href="mailto:@SiteOptions.Value.ContactEmail">@SiteOptions.Value.ContactEmail</a>
                <a href="https://www.khabzelaconsulting.co.za">www.khabzelaconsulting.co.za</a>
            </address>
        </div>
        <div class="site-container footer-bottom">
            <span>&copy; @DateTime.Now.Year Khabzela Consulting</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy &amp; POPIA</a>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    <script src="~/js/layouts/public.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
