@model ProfilePage
@{
    ViewData["Title"] = "Profile";
    var phone = string.IsNullOrWhiteSpace(Model.AccountantPhone) ? "0728792715" : Model.AccountantPhone.Replace(" ", "");
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/client/profile.css" asp-append-version="true" />
}

<header class="profile-head">
    <span class="avatar avatar-lg">@Model.Initial</span>
    <div>
        <h1>@Model.FullName</h1>
        <p class="muted small">@Model.Summary</p>
    </div>
</header>

<div class="profile-grid">
    <form class="card card-pad profile-form" novalidate data-profile-form>
        <h2>Personal details</h2>
        <div class="field">
            <label class="label" for="fullName">Full name</label>
            <input class="input" id="fullName" name="fullName" value="@Model.FullName" required autocomplete="name" />
        </div>
        <div class="field">
            <label class="label" for="email">Email</label>
            <input class="input" id="email" name="email" type="email" value="@Model.Email" required autocomplete="email" />
        </div>
        <div class="field">
            <label class="label" for="phone">Mobile number</label>
            <input class="input" id="phone" name="phone" type="tel" value="@Model.Phone" pattern="^(\+27|0)[\d\s]{9,12}$" autocomplete="tel" />
        </div>
        <div class="field">
            <label class="label" for="company">Business name <span class="muted">(optional)</span></label>
            <input class="input" id="company" name="company" value="@Model.Company" maxlength="120" autocomplete="organization" />
        </div>
        <p class="field-error" role="alert" data-profile-error></p>
        <button class="btn btn-primary" type="submit" data-save disabled>Save changes</button>
    </form>

    <div class="profile-side">
        <section class="card card-pad">
            <h2>Notifications</h2>
            <ul class="profile-toggles">
                <li>
                    <label class="switch-row">
                        <span>
                            <span class="switch-title">Tax status changes</span>
                            <span class="muted small">Email copies when your tax status changes</span>
                        </span>
                        <input type="checkbox" class="switch" checked="@Model.NotifyTax" data-pref="tax" />
                    </label>
                </li>
                <li>
                    <label class="switch-row">
                        <span>
                            <span class="switch-title">Deadline reminders</span>
                            <span class="muted small">Email copies of provisional tax reminders</span>
                        </span>
                        <input type="checkbox" class="switch" checked="@Model.NotifyDeadlines" data-pref="deadlines" />
                    </label>
                </li>
                <li>
                    <label class="switch-row">
                        <span>
                            <span class="switch-title">Email copies</span>
                            <span class="muted small">Send a copy of notifications to your email</span>
                        </span>
                        <input type="checkbox" class="switch" checked="@Model.NotifyEmail" data-pref="email" />
                    </label>
                </li>
            </ul>
        </section>

        <section class="card profile-links">
            <a asp-action="Invoices"><svg class="icon"><use href="#i-file" /></svg><span>Invoices</span><svg class="icon icon-sm"><use href="#i-chevron-right" /></svg></a>
            <a asp-controller="Account" asp-action="TwoFactor"><svg class="icon"><use href="#i-lock" /></svg><span>Two-factor authentication · @(Model.TwoFactorEnabled ? "On" : "Off")</span><svg class="icon icon-sm"><use href="#i-chevron-right" /></svg></a>
            <a href="tel:@phone"><svg class="icon"><use href="#i-phone" /></svg><span>Call your accountant</span><svg class="icon icon-sm"><use href="#i-chevron-right" /></svg></a>
            <form method="post" asp-controller="Account" asp-action="Logout">
                <button type="submit" class="profile-signout"><svg class="icon"><use href="#i-logout" /></svg><span>Sign out</span></button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/client/profile.js" asp-append-version="true"></script>
}
