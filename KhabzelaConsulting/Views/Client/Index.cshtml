@model ClientHomePage
@{
    ViewData["Title"] = "Home";
    var firstName = Model.FirstName;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/client/home.css" asp-append-version="true" />
}

<section class="home">
    <header class="home-greeting">
        <div>
            <p class="muted" data-greeting>Welcome back,</p>
            <h1>@firstName</h1>
        </div>
        <a class="avatar avatar-lg home-avatar" asp-action="Profile" aria-label="Your profile">@Model.Initial</a>
    </header>

    @if (Model.Deadlines.FirstOrDefault() is { } next)
    {
        var days = (next.Due - Model.Today).Days;
        <a class="home-alert" asp-action="Notifications">
            <svg class="icon"><use href="#i-clock" /></svg>
            <span>
                <strong>@next.Title due @(days == 0 ? "today" : days == 1 ? "tomorrow" : $"in {days} days")</strong>
                <span class="home-alert-link">@next.Due.ToString("dddd d MMMM") · View notifications →</span>
            </span>
        </a>
    }

    <div class="home-grid">
        <div class="home-actions">
            <p class="eyebrow section-label">Quick actions</p>

            <a class="home-cta" asp-action="Quote">
                <svg class="icon icon-lg"><use href="#i-quote" /></svg>
                <span class="home-cta-text">
                    <strong>Get a quote &amp; book an appointment</strong>
                    <span>One flow — see a price, then pick a time</span>
                </span>
                <svg class="icon"><use href="#i-chevron-right" /></svg>
            </a>

            <div class="home-tiles">
                <a class="home-tile" asp-action="Invoices">
                    <svg class="icon"><use href="#i-file" /></svg>
                    <span>View invoices</span>
                </a>
                <a class="home-tile" asp-action="Notifications">
                    <svg class="icon"><use href="#i-bell" /></svg>
                    <span>Notifications</span>
                </a>
            </div>
        </div>

        <div class="home-activity">
            @if (Model.Deadlines.Count > 0)
            {
                <p class="eyebrow section-label">Upcoming SARS deadlines</p>
                <ul class="home-activity-list home-deadlines">
                    @foreach (var d in Model.Deadlines)
                    {
                        <li>
                            <span class="home-deadline">
                                <span>@d.Title</span>
                                <span class="small text-muted">@d.Detail</span>
                            </span>
                            <span class="small text-muted">@d.Due.ToString("d MMM")</span>
                        </li>
                    }
                </ul>
            }

            <p class="eyebrow section-label">Recent activity</p>
            <ul class="home-activity-list">
                @if (Model.Activity.Count == 0)
                {
                    <li><span class="muted">Nothing yet — get a quote to get started.</span></li>
                }
                @foreach (var item in Model.Activity)
                {
                    <li>
                        <a href="@item.Href">
                            <span>@item.Title</span>
                            <span class="small @(item.Tone == "success" ? "text-success" : "text-muted")">@item.Meta</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/pages/client/home.js" asp-append-version="true"></script>
}
