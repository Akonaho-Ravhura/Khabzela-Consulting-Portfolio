@model List<ContactMessage>
@{
    ViewData["Title"] = "Enquiries";
    var clock = (KhabzelaConsulting.Services.SaClock)ViewData["Clock"]!;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/team.css" asp-append-version="true" />
}

<p class="admin-page-intro">Messages sent from the website's Contact page, newest first. Reply by email or phone.</p>

<section class="card">
    <table class="table table-stack">
        <thead>
            <tr><th>From</th><th>Interested in</th><th>Message</th><th>Received</th></tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="4" class="muted">No enquiries yet.</td></tr>
            }
            @foreach (var m in Model)
            {
                <tr>
                    <td data-label="">
                        <span class="team-name">
                            <span><strong>@m.Name</strong>
                                <a class="muted small" href="mailto:@m.Email?subject=@Uri.EscapeDataString("Re: your enquiry to Khabzela Consulting")">@m.Email</a>
                                @if (!string.IsNullOrEmpty(m.Phone)) { <a class="muted small" href="tel:@m.Phone.Replace(" ", "")">@m.Phone</a> }
                            </span>
                        </span>
                    </td>
                    <td data-label="Interested in">@(m.Service ?? "General enquiry")</td>
                    <td data-label="Message" style="white-space:pre-line;max-width:420px">@m.Message</td>
                    <td data-label="Received" class="text-muted">@clock.ToLocal(m.CreatedAt).ToString("d MMM yyyy, HH:mm")@(m.EmailSent ? " · emailed" : "")</td>
                </tr>
            }
        </tbody>
    </table>
</section>
