@model List<QuoteRow>
@{
    ViewData["Title"] = "Dashboard";
    var stats = (List<DashboardStat>)ViewData["Stats"]!;
    var requests = Model;
    var deadlines = (List<ClientDeadlineRow>)ViewData["Deadlines"]!;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/dashboard.css" asp-append-version="true" />
}

<div class="dash-stats">
    @foreach (var s in stats)
    {
        <a class="card dash-stat" href="@s.Href">
            <span class="eyebrow">@s.Label</span>
            <span class="dash-stat-value" data-count="@s.Value">@s.Value</span>
            <span class="dash-stat-trend">@s.Trend</span>
        </a>
    }
</div>

<section class="card dash-requests">
    <header class="card-header">
        <h2>Recent quote requests</h2>
        <a class="btn-link small" asp-action="QuoteRequests">View all →</a>
    </header>
    <table class="table table-stack">
        <thead>
            <tr><th>Client</th><th>Service</th><th>Estimate</th><th>Status</th><th>Date</th></tr>
        </thead>
        <tbody>
            @if (requests.Count == 0)
            {
                <tr><td colspan="5" class="muted">No quote requests yet.</td></tr>
            }
            @foreach (var r in requests)
            {
                <tr data-href="@Url.Action("QuoteRequests")">
                    <td data-label="Client"><strong class="dash-client">@r.Client</strong></td>
                    <td data-label="Service">@r.Service</td>
                    <td data-label="Estimate">@r.Estimate</td>
                    <td data-label="Status"><span class="badge badge-@r.Status.ToLowerInvariant()">@r.Status</span></td>
                    <td data-label="Date" class="text-muted">@r.Date.ToString("d MMM")</td>
                </tr>
            }
        </tbody>
    </table>
</section>

<section class="card dash-requests dash-deadlines">
    <header class="card-header">
        <h2>SARS deadlines — next 14 days</h2>
        <span class="muted small">Clients get an automatic reminder 7 days before</span>
    </header>
    <table class="table table-stack">
        <thead>
            <tr><th>Client</th><th>Return</th><th>Due</th><th>Days left</th></tr>
        </thead>
        <tbody>
            @if (deadlines.Count == 0)
            {
                <tr><td colspan="4" class="muted">No client deadlines in the next 14 days. Set each client's tax profile on their page to track them.</td></tr>
            }
            @foreach (var d in deadlines)
            {
                <tr data-href="@Url.Action("ClientDetail", new { id = d.ClientId })">
                    <td data-label="Client"><strong class="dash-client">@d.Client</strong></td>
                    <td data-label="Return">@d.Return<span class="muted small" style="display:block">@d.Detail</span></td>
                    <td data-label="Due">@d.Due.ToString("ddd d MMM")</td>
                    <td data-label="Days left"><span class="badge @(d.DaysLeft <= 3 ? "badge-overdue" : d.DaysLeft <= 7 ? "badge-due" : "badge-draft")">@(d.DaysLeft == 0 ? "Today" : $"{d.DaysLeft} day{(d.DaysLeft == 1 ? "" : "s")}")</span></td>
                </tr>
            }
        </tbody>
    </table>
</section>

@section Scripts {
    <script src="~/js/pages/admin/dashboard.js" asp-append-version="true"></script>
}
