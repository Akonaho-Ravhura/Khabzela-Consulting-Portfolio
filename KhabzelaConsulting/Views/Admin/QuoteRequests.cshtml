@model List<QuoteRow>
@{
    ViewData["Title"] = "Quote requests";
    var requests = Model;
    var statuses = QuoteStatuses.All;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/quote-requests.css" asp-append-version="true" />
}

<div class="qr-toolbar">
    <div class="choice-group qr-tabs" role="group" aria-label="Filter by status" data-filter-group>
        <button type="button" class="choice is-active" data-value="all" aria-pressed="true">All <span data-count="all"></span></button>
        @foreach (var s in statuses)
        {
            <button type="button" class="choice" data-value="@s" aria-pressed="false">@s <span data-count="@s"></span></button>
        }
    </div>
</div>

<section class="card">
    <table class="table table-stack">
        <thead>
            <tr><th>Client</th><th>Service</th><th>Estimate</th><th>Appointment</th><th>Status</th><th>Date</th></tr>
        </thead>
        <tbody data-request-rows>
            @foreach (var r in requests)
            {
                <tr data-status="@r.Status" data-id="@r.Id">
                    <td data-label="">
                        <span class="qr-client">
                            <strong>@r.Client</strong>
                            <a class="muted small" href="mailto:@r.Email">@r.Email</a>
                        </span>
                    </td>
                    <td data-label="Service">
                        <span class="qr-service">@r.Service<span class="muted small">@r.Detail</span></span>
                    </td>
                    <td data-label="Estimate">@r.Estimate</td>
                    <td data-label="Appointment">@r.Appointment</td>
                    <td data-label="Status">
                        <select class="qr-status badge badge-@r.Status.ToLowerInvariant()" aria-label="Status for @r.Client" data-status-select>
                            @foreach (var s in statuses)
                            {
                                <option selected="@(s == r.Status)">@s</option>
                            }
                        </select>
                    </td>
                    <td data-label="Date" class="text-muted">@r.Date.ToString("d MMM")</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="qr-empty muted" data-empty @(requests.Count == 0 ? "" : "hidden")>@(requests.Count == 0 ? "No quote requests yet — they arrive when clients book through the app." : "No requests with this status.")</p>
</section>

@section Scripts {
    <script src="~/js/pages/admin/quote-requests.js" asp-append-version="true"></script>
}
