@model ResetPasswordInput
@{
    ViewData["Title"] = Model.Invite ? "Set up your team account" : "Choose a new password";
    string? Err(string key) => ViewData.ModelState[key]?.Errors.FirstOrDefault()?.ErrorMessage;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/account/forgot-password.css" asp-append-version="true" />
}

<div class="forgot">
    <header class="forgot-head">
        <h1>@(Model.Invite ? "Welcome to the team" : "Choose a new password")</h1>
        @if (Model.Invite)
        {
            <p class="lead">You've been invited to the Khabzela Consulting admin portal as <strong>@Model.Email</strong>. Choose a password to finish setting up your account.</p>
        }
        <p class="lead">At least 8 characters, with upper- and lowercase letters and a number.</p>
    </header>

    <form class="forgot-form" method="post" asp-action="ResetPassword" novalidate>
        <div class="form-alert" role="alert" asp-validation-summary="ModelOnly"></div>
        <input type="hidden" name="email" value="@Model.Email" />
        <input type="hidden" name="token" value="@Model.Token" />
        <input type="hidden" name="invite" value="@Model.Invite.ToString().ToLowerInvariant()" />
        <div class="field">
            <label class="label" for="password">New password</label>
            <input class="input" id="password" name="password" type="password" autocomplete="new-password" required minlength="8" />
            <span class="field-error">@Err("Password")</span>
        </div>
        <div class="field">
            <label class="label" for="confirmPassword">Confirm new password</label>
            <input class="input" id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required />
            <span class="field-error">@Err("ConfirmPassword")</span>
        </div>
        <button class="btn btn-primary btn-block" type="submit">@(Model.Invite ? "Set password" : "Update password")</button>
    </form>
</div>
