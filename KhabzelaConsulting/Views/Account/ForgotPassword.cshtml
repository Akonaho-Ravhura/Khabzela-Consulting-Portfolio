@{
    ViewData["Title"] = "Reset password";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/account/forgot-password.css" asp-append-version="true" />
}

<div class="forgot">
    <a class="forgot-back btn-link small" asp-action="Login">
        <svg class="icon icon-sm"><use href="#i-chevron-left" /></svg> Back to sign in
    </a>

    <div data-forgot-step="request">
        <header class="forgot-head">
            <h1>Reset your password</h1>
            <p class="lead">Enter the email linked to your account and we'll send you a reset link.</p>
        </header>

        <form class="forgot-form" novalidate data-forgot-form>
            <div class="field">
                <label class="label" for="email">Email address</label>
                <input class="input" id="email" name="email" type="email" autocomplete="email" required />
                <span class="field-error" data-error-for="email"></span>
            </div>
            <button class="btn btn-primary btn-block" type="submit">Send reset link</button>
        </form>
    </div>

    <div class="forgot-sent card card-pad" data-forgot-step="sent" hidden>
        <span class="forgot-sent-icon"><svg class="icon"><use href="#i-mail" /></svg></span>
        <h2>Check your inbox</h2>
        <p class="muted">If an account exists for <strong data-sent-email></strong>, a reset link is on its way. It expires in 30 minutes.</p>
        <a class="btn btn-outline btn-block" asp-action="Login">Return to sign in</a>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/account/forgot-password.js" asp-append-version="true"></script>
}
