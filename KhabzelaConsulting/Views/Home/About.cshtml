@{
    ViewData["Title"] = "About us";
    ViewData["Description"] = "Khabzela Consulting is a Centurion-based accounting firm, established in 2010, providing accounting, payroll and tax services to SMEs.";

    var images = new[]
    {
        new { Image = "about-1", Alt = "Coins with a small plant growing from them" },
        new { Image = "about-2", Alt = "Growth chart on paper with a pen and ruler" },
        new { Image = "about-3", Alt = "Two people working on laptops and notes" },
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/home/about.css" asp-append-version="true" />
}

<section class="page-head">
    <div class="site-container">
        <p class="eyebrow">About us</p>
        <h1>We offer accounting, payroll and tax services tailored to our clients' requirements.</h1>
    </div>
</section>

<section class="about-body">
    <div class="site-container">
        <div class="panel">
            <div class="about-images">
                @foreach (var img in images)
                {
                    <img src="~/images/@(img.Image)-sm.jpg" srcset="/images/@(img.Image)-sm.jpg 420w, /images/@(img.Image).jpg 700w" sizes="(max-width: 700px) 100vw, 350px"
                         width="700" height="460" alt="@img.Alt" decoding="async" />
                }
            </div>
            <p>Khabzela Consulting is a Centurion based accounting firm, established in 2010. At Khabzela Consulting, we provide Accounting, Payroll and Tax Services to small and medium sized enterprises. We have the expertise and experience that clients trust. Meet with us to discover why we're the leading accounting firm in Centurion.</p>
        </div>
    </div>
</section>
