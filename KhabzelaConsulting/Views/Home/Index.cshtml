@{
    ViewData["Title"] = "Accounting, payroll & tax in Centurion";

    // Service descriptions from the firm's own website.
    var services = new[]
    {
        new { Image = "service-accounting", Alt = "Laptop showing financial reports", Name = "Accounting", Text = "We provide our clients with monthly management accounts and annual financial statements to enable them to understand the financial performance of their businesses." },
        new { Image = "service-payroll", Alt = "Person paying online with a card on a laptop", Name = "Payroll", Text = "Our payroll team provides weekly and monthly payroll services which includes issuing pay-slips and UIF declarations. Annual tax certificates (IRP5s) are issued at the end of the tax year." },
        new { Image = "service-tax", Alt = "Tax statement and forms on a desk", Name = "Tax", Text = "We prepare monthly PAYE and VAT returns for our clients. We further do bi-annual provisional tax returns (IRP6s) and annual income tax returns (IT14s)." },
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/home/index.css" asp-append-version="true" />
}

<section class="hero">
    <div class="site-container">
        <h1>We're the accounting and tax experts</h1>
        <p>We're happy to be a Centurion-based accounting firm. Let us help you meet your accounting, payroll and tax requirements.</p>
        <a class="btn btn-primary" asp-action="Contact">Contact us</a>
        @* Above the fold: load first, smaller file on phones. *@
        <img class="hero-image" src="~/images/hero.jpg" srcset="/images/hero-sm.jpg 760w, /images/hero.jpg 1600w" sizes="(max-width: 1232px) 100vw, 1200px"
             width="1600" height="700" alt="Tax forms, a calculator and documents on a desk" fetchpriority="high" decoding="async" />
    </div>
</section>

<section class="section offering" id="services">
    <div class="site-container">
        <header class="offering-head">
            <p class="eyebrow">Our offering</p>
            <h2>Our Services</h2>
        </header>
        <div class="offering-grid">
            @foreach (var s in services)
            {
                <article class="offering-card">
                    <img src="~/images/@(s.Image)-sm.jpg" srcset="/images/@(s.Image)-sm.jpg 480w, /images/@(s.Image).jpg 800w" sizes="(max-width: 760px) 100vw, 380px"
                         width="800" height="520" alt="@s.Alt" loading="lazy" decoding="async" />
                    <h3>@s.Name</h3>
                    <p>@s.Text</p>
                </article>
            }
        </div>
    </div>
</section>

<!-- Tax compliance alerts (client app feature) -->
<section class="section alerts" id="alerts">
    <div class="site-container alerts-inner">
        <div class="alerts-copy">
            <p class="eyebrow">Tax compliance alerts</p>
            <h2>Know your tax status before it becomes a problem</h2>
            <p>Too often, businesses only hear about a SARS issue once it's already affecting them. As a Khabzela client, our app keeps you informed:</p>
            <ul class="alerts-list">
                <li><svg class="icon icon-sm"><use href="#i-check" /></svg><span><strong>Tax status updates.</strong> When your status changes (submitted, SARS query, assessed or refund due), you're notified straight away, with a note from your accountant.</span></li>
                <li><svg class="icon icon-sm"><use href="#i-check" /></svg><span><strong>Deadline reminders a week ahead.</strong> EMP201, VAT201, provisional tax (IRP6), EMP501 and ITR14, worked out for your business.</span></li>
                <li><svg class="icon icon-sm"><use href="#i-check" /></svg><span><strong>In the app, or by email.</strong> Check it on your phone or computer, and switch on email copies if you prefer.</span></li>
                <li><svg class="icon icon-sm"><use href="#i-check" /></svg><span><strong>Your SARS login stays private.</strong> No eFiling password is needed and no tax documents are stored in the app.</span></li>
            </ul>

            @* Entry points to the separate client app. *@
            <div class="app-links" aria-label="Client app">
                <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Create a client account</a>
                <a class="btn btn-outline" asp-controller="Client" asp-action="Quote">Get a quote</a>
                <a class="btn btn-outline" asp-controller="Account" asp-action="Login">Client login</a>
            </div>
        </div>

        <figure class="alerts-visual">
            <ul class="alerts-feed" aria-label="Example notifications">
                <li class="alerts-note">
                    <span class="alerts-icon"><svg class="icon"><use href="#i-clock" /></svg></span>
                    <span>
                        <strong>Your tax status changed to “Assessed”</strong>
                        <span>No action needed — we'll follow up if anything is required.</span>
                        <time>Today, 09:14</time>
                    </span>
                </li>
                <li class="alerts-note">
                    <span class="alerts-icon"><svg class="icon"><use href="#i-calendar" /></svg></span>
                    <span>
                        <strong>VAT201 return due in 7 days</strong>
                        <span>VAT period ending September. Due Friday 30 October.</span>
                        <time>Friday, 08:00</time>
                    </span>
                </li>
                <li class="alerts-note">
                    <span class="alerts-icon"><svg class="icon"><use href="#i-calendar" /></svg></span>
                    <span>
                        <strong>EMP201 payroll return due in 7 days</strong>
                        <span>PAYE, UIF and SDL for October.</span>
                        <time>Last week</time>
                    </span>
                </li>
            </ul>
            <figcaption>Example notifications from the Khabzela client app.</figcaption>
        </figure>
    </div>
</section>
