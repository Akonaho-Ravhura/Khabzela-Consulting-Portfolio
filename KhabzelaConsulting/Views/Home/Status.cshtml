@{
    var code = ViewData["Code"] as int? ?? 500;
    ViewData["Title"] = code == 404 ? "Page not found" : "Something went wrong";
    var (heading, text) = code switch
    {
        404 => ("We can't find that page", "The link may be old or mistyped. Try the home page, or contact us if you need help."),
        429 => ("Too many attempts", "Please wait a few minutes and try again."),
        _ => ("Something went wrong", "Please try again in a moment. If it keeps happening, call us on 072 879 2715."),
    };
}

<section class="page-hero">
    <div class="site-container">
        <p class="eyebrow">Error @code</p>
        <h1>@heading</h1>
        <p class="lead">@text</p>
        <p style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go to the home page</a>
            <a class="btn btn-outline" asp-controller="Home" asp-action="Contact">Contact us</a>
        </p>
    </div>
</section>
